# Production reverse proxy for the Job Portal.
#
# One site, path-based:
#   {$SITE_DOMAIN}/api/job/*        -> job-service:3001   (prefix stripped)
#   {$SITE_DOMAIN}/api/candidate/*  -> candidate-service:3002 (prefix stripped)
#   {$SITE_DOMAIN}/*                -> frontend static bundle (nginx:8080)
#
# `/internal/*` and `/api/*/internal/*` are a hard 404 at the edge (I8).
# Services only talk to each other over the private compose network.
#
# TLS:
#   CADDY_TLS unset/empty -> automatic public ACME certificates
#   CADDY_TLS=internal    -> local CA for `make prod-local`
#   CADDY_TLS=<email>     -> automatic ACME with that account email
#
# Caddy sets X-Forwarded-Proto automatically, which Django uses through
# SECURE_PROXY_SSL_HEADER to stop the HTTPS redirect loop. Django also sets
# FORCE_SCRIPT_NAME=/api/job or /api/candidate so generated URLs and slash
# redirects keep the public prefix.

(security_headers) {
	header {
		Strict-Transport-Security "{$HSTS_HEADER}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	encode zstd gzip
}

{$SITE_DOMAIN} {
	tls {$CADDY_TLS}
	import security_headers
	route {
		# Legacy and edge paths. These run on the original request path.
		@edgeInternal path /internal /internal/* /api/job/internal /api/job/internal/* /api/candidate/internal /api/candidate/internal/*
		respond @edgeInternal "Not Found" 404

		# A bare API root has no meaning; do not let the SPA answer it.
		@apiRoot path /api/job /api/candidate
		respond @apiRoot "Not Found" 404

		handle_path /api/job/* {
			# The prefix is stripped here, so match the remaining path.
			@internal path /internal /internal/*
			respond @internal "Not Found" 404
			reverse_proxy job-service:3001
		}

		handle_path /api/candidate/* {
			@internal path /internal /internal/*
			respond @internal "Not Found" 404
			reverse_proxy candidate-service:3002
		}

		handle {
			reverse_proxy frontend:8080
		}
	}
}
