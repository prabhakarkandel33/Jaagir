# Production environment for deploy/docker-compose.prod.yml.
#
# Copy to deploy/.env.prod and fill in real values (deploy/scripts/render-env.sh
# does this on the VPS from CI secrets; the file is chmod 600 and never echoed).
# `make prod-local` copies this example automatically for a local trial run.
#
# Never commit `.env.prod` (invariant I6).

COMPOSE_PROJECT_NAME=jobportal
LOG_LEVEL=INFO

# --- Image tags (deploy.sh overrides IMAGE_TAG per release) ---
JOB_IMAGE=jobportal/job-service
CANDIDATE_IMAGE=jobportal/candidate-service
FRONTEND_IMAGE=jobportal/frontend
IMAGE_TAG=latest

# --- Domain / public URLs ---
# One host. Caddy routes /api/job/* and /api/candidate/* to the services and
# sends every other path to the frontend.
# Local trial: jaagir.localhost with the internal CA on https://...:8443.
# Production: the DNS A/AAAA record must exist before the first deploy.
SITE_DOMAIN=jaagir.localhost
JOB_PUBLIC_URL=https://jaagir.localhost:8443/api/job
CANDIDATE_PUBLIC_URL=https://jaagir.localhost:8443/api/candidate
FRONTEND_PUBLIC_URL=https://jaagir.localhost:8443
ALLOWED_HOSTS=jaagir.localhost,localhost,127.0.0.1
# 0 keeps browsers from pinning localhost to HTTPS during a trial run.
SECURE_HSTS_SECONDS=0
HSTS_HEADER=max-age=0

# --- TLS: internal (local CA) | empty (public ACME) | an ACME account email ---
CADDY_TLS=internal
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-50-random-characters
INTERNAL_TOKEN=change-me-32-bytes-min
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# --- Databases (keep passwords URL-safe: letters, digits, - and _) ---
JOB_DB_USER=jobportal
JOB_DB_PASSWORD=change-me-job-db-password
CANDIDATE_DB_USER=jobportal
CANDIDATE_DB_PASSWORD=change-me-candidate-db-password

# --- JWT: base64 of a PEM keypair (newlines survive base64) ---
# Each service signs its own users. The candidate service also verifies
# recruiter tokens with JOB_JWT_PUBLIC_KEY.
# Generate with:
#   uv run python -c "print(...)"   (see docs/deployment.md)
JOB_JWT_SIGNING_KEY=
JOB_JWT_PUBLIC_KEY=
CANDIDATE_JWT_SIGNING_KEY=
CANDIDATE_JWT_PUBLIC_KEY=
