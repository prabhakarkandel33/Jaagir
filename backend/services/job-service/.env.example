# Job Service environment. Copy to `.env` for local dev. Never commit `.env`.
# Placeholders only (invariant I6).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_HOSTS=*

# --- Database (its own Postgres; port 5433 on the host) ---
DATABASE_URL=postgres://jobportal:jobportal@localhost:5433/job_db

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Kafka (optional for availability) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OUTBOX_RELAY_ENABLED=true

# --- Internal endpoints (invariant I8) ---
INTERNAL_TOKEN=change-me-32-bytes-min

# --- JWT (asymmetric). Base64-encoded PEM (newlines survive base64). ---
JWT_ALGORITHM=ES256
JWT_ISSUER=job-service
JWT_SIGNING_KEY=
JWT_PUBLIC_KEY=
