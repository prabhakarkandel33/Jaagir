# Candidate Service environment. Copy to `.env` for local dev. Never commit `.env`.
# Placeholders only (invariant I6).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_HOSTS=*

# --- Database (its own Postgres; port 5434 on the host) ---
DATABASE_URL=postgres://jobportal:jobportal@localhost:5434/candidate_db

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Kafka (optional for availability) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=candidate-service

# --- Reconciliation ---
RECONCILE_INCREMENTAL_SECONDS=300
RECONCILE_BATCH_LIMIT=500

# --- Internal endpoints (invariant I8) + Job Service internal URL ---
INTERNAL_TOKEN=change-me-32-bytes-min
JOB_SERVICE_INTERNAL_URL=http://localhost:3001

# --- JWT (asymmetric). Base64-encoded PEM. Generate in M7. ---
JWT_ALGORITHM=ES256
JWT_ISSUER=candidate-service
JWT_SIGNING_KEY=
JWT_PUBLIC_KEY=
# Public key of the Job Service, to accept recruiter tokens.
JOB_SERVICE_JWT_PUBLIC_KEY=
