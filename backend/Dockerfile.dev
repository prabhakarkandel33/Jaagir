# Shared DEVELOPMENT image for both Django services.
#
# Build context: the backend/ directory (this file lives in backend/).
# The source is bind-mounted at runtime by deploy/docker-compose.dev-full.yml,
# so this image only needs the dependencies; edits and hot reload happen on the
# host. The production images are a separate milestone (M7) with gunicorn and a
# multi-stage build.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# uv (single static binary, no curl needed).
COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /uvx /bin/

WORKDIR /app

# Dependency layer first, so a source edit does not reinstall dependencies.
COPY pyproject.toml uv.lock .python-version ./
COPY packages/contracts/pyproject.toml packages/contracts/
COPY services/job-service/pyproject.toml services/job-service/
COPY services/candidate-service/pyproject.toml services/candidate-service/
RUN uv sync --all-packages --frozen

# Source (overwritten by the bind mounts at runtime; kept so the image is
# usable on its own for a quick check).
COPY . .

# No default command: compose sets one per service (runserver | run_relay |
# consume_events). This keeps ONE image for all of them.
CMD ["python", "-c", "raise SystemExit('set a command: see docker-compose.dev-full.yml')"]
