openapi: 3.0.3
info:
  title: Candidate & Application Service API
  version: 0.1.0
  description: Candidates, applications and the job replica.
paths:
  /healthz:
    get:
      operationId: healthz_retrieve
      description: Liveness probe. Always 200 while the process is up.
      tags:
      - healthz
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /readyz:
    get:
      operationId: readyz_retrieve
      description: Readiness probe. Fails only when the database is down. Kafka and
        the consumer are reported but never fail readiness.
      tags:
      - readyz
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
        '503':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
components:
  securitySchemes:
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
